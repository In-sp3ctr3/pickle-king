#!/bin/sh
set -eu

case "$#:${1-}" in
  0:) mode=default ;;
  1:--changed) mode=default; echo 'verify: --changed uses default coverage (no reliable change selector configured).' ;;
  1:--full) mode=full ;;
  *) echo 'Usage: ./scripts/verify [--changed|--full]' >&2; exit 2 ;;
esac

cd "$(dirname "$0")/.."
echo "verify: $mode"
python3 -B -m unittest discover -s tests -p test_harness_status.py
npm run vinext:check
npm run format:check
npm run check

if [ "$mode" = full ]; then
  node --test tests/rendered-html.test.mjs tests/pwa-artifacts.test.mjs
  port=${PICKLE_KING_VERIFY_PORT:-3000}
  case "$port" in
    ''|*[!0-9]*) echo 'verify: PICKLE_KING_VERIFY_PORT must be a port number.' >&2; exit 2 ;;
  esac
  if [ "${#port}" -gt 5 ] || [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
    echo 'verify: PICKLE_KING_VERIFY_PORT must be between 1 and 65535.' >&2
    exit 2
  fi
  url="http://127.0.0.1:$port"
  if curl --silent --output /dev/null --max-time 2 "$url"; then
    echo "verify: port $port is already serving; cannot prove server identity." >&2
    exit 1
  fi
  PORT="$port" NEXT_PUBLIC_SITE_URL="$url" WRANGLER_LOG_PATH=.wrangler/wrangler.log ./node_modules/.bin/vinext start > /tmp/pickle-king-verify-server.log 2>&1 &
  server_pid=$!
  trap 'kill "$server_pid" 2>/dev/null || true' EXIT HUP INT TERM
  attempt=0
  until curl --fail --silent --output /dev/null "$url"; do
    if ! kill -0 "$server_pid" 2>/dev/null; then
      cat /tmp/pickle-king-verify-server.log >&2
      exit 1
    fi
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 30 ]; then
      echo 'verify: production server did not become ready within 30 seconds.' >&2
      exit 1
    fi
    sleep 1
  done
  FRONTEND_BASE_URL="$url" npm run test:share-visual
fi
