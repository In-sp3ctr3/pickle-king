{
  "name": "pickle-king",
  "version": "1.0.0",
  "description": "An offline-first pickleball tournament and scoring PWA.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL:-http://127.0.0.1:3000} WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && serwist build serwist.config.js",
    "start": "NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL:-http://127.0.0.1:3000} WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "vinext:check": "vinext check",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:render": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:pwa": "node --test tests/pwa-artifacts.test.mjs",
    "check:lines": "node scripts/check-file-length.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:lines && npm run test && npm run build",
    "frontend:audit:assets": "node scripts/raw-svg-audit.mjs",
    "frontend:audit:controls": "node scripts/frontend-dead-click-audit.mjs",
    "frontend:audit:evidence": "node scripts/frontend-evidence-preflight.mjs",
    "frontend:audit:contract": "node scripts/frontend-contract-audit.mjs",
    "frontend:test": "playwright test tests/playwright/frontend-harness.spec.ts",
    "frontend:test:responsive": "playwright test tests/playwright/responsive-layout.spec.ts",
    "frontend:test:workflows": "playwright test tests/playwright/product-workflows.spec.ts",
    "frontend:qa": "node scripts/raw-svg-audit.mjs && node scripts/frontend-dead-click-audit.mjs && node scripts/frontend-evidence-preflight.mjs && playwright test tests/playwright/frontend-harness.spec.ts && node scripts/frontend-contract-audit.mjs",
    "frontend:compare": "node scripts/frontend-visual-compare.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/In-sp3ctr3/pickle-king.git"
  },
  "bugs": {
    "url": "https://github.com/In-sp3ctr3/pickle-king/issues"
  },
  "homepage": "https://github.com/In-sp3ctr3/pickle-king#readme",
  "overrides": {
    "fast-uri": "3.1.5",
    "nanoid": "3.3.17",
    "miniflare": {
      "undici": "7.29.0"
    },
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@number-flow/react": "^0.6.2",
    "@radix-ui/react-select": "^2.3.7",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.29.0",
    "motion": "^13.0.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "serwist": "^9.5.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "1.49.0",
    "@playwright/test": "^1.62.1",
    "@serwist/cli": "^9.5.12",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "22.19.19",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.32",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-boundaries": "^7.1.0",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "^0.0.45",
    "vite": "8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "4.116.0"
  },
  "type": "module"
}
