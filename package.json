{
  "name": "pickle-king",
  "version": "1.10.0",
  "description": "An offline-first pickleball tournament and scoring PWA.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL:-http://127.0.0.1:3000} WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && serwist build serwist.config.js",
    "start": "NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL:-http://127.0.0.1:3000} WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "vinext:check": "vinext check",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "typecheck:convex": "tsc --noEmit -p convex/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:render": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:pwa": "node --test tests/pwa-artifacts.test.mjs",
    "test:specs": "node --test tests/spec-workspaces.test.mjs",
    "check:lines": "node scripts/check-file-length.mjs",
    "check": "npm run lint && npm run typecheck && npm run typecheck:convex && npm run check:lines && npm run test:specs && npm run test && npm run build",
    "frontend:audit:assets": "node scripts/raw-svg-audit.mjs",
    "frontend:audit:controls": "node scripts/frontend-dead-click-audit.mjs",
    "frontend:audit:evidence": "node scripts/frontend-evidence-preflight.mjs",
    "frontend:audit:contract": "node scripts/frontend-contract-audit.mjs",
    "frontend:test": "playwright test tests/playwright/frontend-harness.spec.ts",
    "frontend:test:responsive": "playwright test tests/playwright/responsive-layout.spec.ts",
    "frontend:test:workflows": "playwright test tests/playwright/product-workflows.spec.ts",
    "test:share-visual": "playwright test tests/playwright/quick-share-visual.spec.ts tests/playwright/share-reference-evidence.spec.ts tests/playwright/session-recap.spec.ts --grep 'locks Quick share PNGs|renders matched-data poster reference evidence|selects the latest day and exports paginated Singles and Doubles receipts|keeps twelve Doubles players on one recap page|keeps eight Doubles players on the dense composition' --browser=chromium --workers=1 --timeout=120000 --update-snapshots=none && node scripts/measure-recap-grid.mjs --check",
    "frontend:qa": "node scripts/raw-svg-audit.mjs && node scripts/frontend-dead-click-audit.mjs && node scripts/frontend-evidence-preflight.mjs && playwright test tests/playwright/frontend-harness.spec.ts --workers=3 && node scripts/frontend-phase-audit.mjs --phase release",
    "frontend:compare": "node scripts/frontend-visual-compare.mjs",
    "frontend:audit:capabilities": "node scripts/frontend-capability-preflight.mjs",
    "frontend:gate": "node scripts/frontend-phase-audit.mjs",
    "frontend:gate:direction": "node scripts/frontend-phase-audit.mjs --phase direction",
    "frontend:gate:prototype": "node scripts/frontend-phase-audit.mjs --phase prototype",
    "frontend:gate:release": "node scripts/frontend-phase-audit.mjs --phase release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/In-sp3ctr3/pickle-king.git"
  },
  "bugs": {
    "url": "https://github.com/In-sp3ctr3/pickle-king/issues"
  },
  "homepage": "https://github.com/In-sp3ctr3/pickle-king#readme",
  "overrides": {
    "fast-uri": "3.1.5",
    "nanoid": "3.3.18",
    "miniflare": {
      "undici": "7.29.0"
    },
    "postcss": "8.5.25",
    "sharp": "$sharp"
  },
  "dependencies": {
    "@fontsource/alfa-slab-one": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo-black": "^5.2.8",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/roboto-condensed": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "@number-flow/react": "^0.6.2",
    "@radix-ui/react-select": "^2.3.7",
    "canvas-confetti": "^1.9.4",
    "convex": "^1.46.0",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "serwist": "^9.5.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.63.0",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "@serwist/cli": "^9.5.13",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "26.6.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "@vitest/coverage-v8": "^5.0.3",
    "convex-test": "^0.0.60",
    "esbuild": "^0.28.2",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.2",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-server-dom-webpack": "19.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vinext": "^1.0.1",
    "vite": "8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "4.148.0"
  },
  "type": "module"
}
