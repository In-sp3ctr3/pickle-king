# Public canonical URL used for metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Browser-public Convex deployment URL. It grants no server authority.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Local tooling selector written by `npx convex dev`; not a credential.
CONVEX_DEPLOYMENT=dev:your-deployment

# Server-only CI/deploy credential. Store the real value in the approved secret store.
# Never prefix this value with NEXT_PUBLIC_.
CONVEX_DEPLOY_KEY=
